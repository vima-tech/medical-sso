# 仅用于本地演示。生产环境必须使用独立的高强度密码并交由密钥系统管理。

# 认证内核首次启动时创建的引导管理员，只存在于 master Realm。
# Keycloak 自带的管理控制台已在引擎层面关闭，这个账号没有任何图形界面可登录，
# 仅在需要用 kc.sh 或 Admin API 做底层排查时使用。
# 日常运维一律用统一身份管理平台的 sso-admin（密码见 README）。
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin-change-me
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=postgres-change-me
# 整套系统对外唯一的端口。认证内核不再对外暴露。
PLATFORM_PORT=18081

# 门户子系统登记功能使用的服务账号，与门户登录 Secret 分开管理
SSO_ADMIN_CLIENT_SECRET=portal-admin-dev-secret
