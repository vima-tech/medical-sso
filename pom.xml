<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>com.medical.union</groupId>
    <artifactId>medical-sso</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>medical-sso</name>
    <description>医共体统一身份认证接入示例</description>

    <modules>
        <!-- 平台本体：唯一进生产镜像的应用 -->
        <module>platform/portal</module>

        <!-- 接入组件：交付给子系统使用，不部署 -->
        <module>integration/starter-boot3</module>
        <module>integration/starter-boot2</module>
        <module>integration/access-proxy</module>

        <!-- 可运行样例：docs/INTEGRATION.md 的配套代码，不部署 -->
        <module>samples/boot3</module>
        <module>samples/boot2</module>
        <module>samples/legacy</module>
    </modules>

    <properties>
        <java.version>17</java.version>
    </properties>
</project>

