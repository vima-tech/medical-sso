# 复制为 .env.production 后填写，严禁把真实值提交到版本库。
SSO_HOSTNAME=sso.intra.example
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=replace-with-database-secret
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-bootstrap-secret
SSO_PLATFORM_ADMIN_PASSWORD=replace-with-initial-platform-admin-password
SSO_ADMIN_CLIENT_SECRET=replace-with-admin-api-client-secret
SSO_PORTAL_CLIENT_SECRET=replace-with-portal-login-client-secret
TLS_CERT_FILE=/absolute/path/to/tls.crt
TLS_KEY_FILE=/absolute/path/to/tls.key
REALM_IMPORT_DIR=/absolute/path/to/generated-production-realm
