FROM docker.io/library/maven:3.9.11-eclipse-temurin-17 AS build
WORKDIR /workspace
COPY . .
RUN mvn -Dmaven.repo.local=/workspace/.m2/repository -q -pl medical-portal -am -DskipTests package

FROM docker.io/library/eclipse-temurin:17-jre
RUN useradd --system --uid 10001 --home-dir /app app
WORKDIR /app
COPY --from=build /workspace/medical-portal/target/medical-portal-0.1.0.jar /app/app.jar
USER 10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
