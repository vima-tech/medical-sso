# 仅用于本地演示。生产环境必须使用独立的高强度密码并交由密钥系统管理。

# 登录 18081 统一身份管理平台的账号。用户名固定为 sso-admin，密码可在这里修改。
# 本地启动时 seed-demo.sh 会把此密码写入 medical Realm。
SSO_PLATFORM_ADMIN_PASSWORD=Admin@123456

# 认证内核首次启动时创建的引导管理员，只存在于 master Realm。
# Keycloak 自带的管理控制台已在引擎层面关闭，这个账号没有任何图形界面可登录，
# 仅在需要用 kc.sh 或 Admin API 做底层排查时使用。
# 日常运维一律用统一身份管理平台的 sso-admin（密码见 README）。
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin-change-me
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=postgres-change-me
# 整套系统对外唯一的端口。认证内核不再对外暴露。
PLATFORM_PORT=18081
# 对外访问地址。认证内核签发的 issuer 和平台的回调地址都由它推导，
# 必须与浏览器实际访问的地址逐字一致——改了 PLATFORM_PORT 就要同步改这里，
# 否则登录会因为 issuer 对不上而失败。生产环境填 HTTPS 域名。
SSO_PUBLIC_URL=http://localhost:18081

# 18081 管理后台调用认证内核时使用的服务凭据，不是任何用户的登录密码。
SSO_ADMIN_CLIENT_SECRET=portal-admin-dev-secret

# 18081 自身参与统一登录时使用的客户端凭据，同样不是用户登录密码。
# 本地演示可保留默认值；生产环境必须分别生成并通过密钥系统注入这两个 Secret。
SSO_PORTAL_CLIENT_SECRET=portal-dev-secret
