<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.medical.union</groupId>
        <artifactId>medical-sso</artifactId>
        <version>0.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>medical-sso-access-proxy</artifactId>
    <name>medical-sso-access-proxy</name>
    <!-- 对客户仍称「接入网关」；这里叫 access-proxy 是为了与 compose 中那个
         nginx 的 gateway 服务区分开——后者是整套平台对外的唯一入口，
         与本模块毫无关系。请求头 X-Medical-Gateway-Token、配置前缀
         medical.sso.gateway.* 是与已接入子系统的线上契约，不随改名变动。 -->
    <description>接入网关（模块名 access-proxy）：在业务系统前面完成统一身份登录，把人员身份以请求头交给后端，业务系统不改代码</description>

    <dependencies>
        <dependency>
            <groupId>com.medical.union</groupId>
            <artifactId>medical-sso-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
